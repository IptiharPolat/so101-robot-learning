diff --git a/tests/policies/test_diffusion_chunk_blending.py b/tests/policies/test_diffusion_chunk_blending.py
new file mode 100644
index 0000000..7a1ad2a
--- /dev/null
+++ b/tests/policies/test_diffusion_chunk_blending.py
@@ -0,0 +1,28 @@
+#!/usr/bin/env python
+
+import pytest
+import torch
+
+from lerobot.policies.diffusion.configuration_diffusion import DiffusionConfig
+from lerobot.policies.diffusion.modeling_diffusion import blend_action_chunk
+
+
+def test_blend_action_chunk_smooths_chunk_start() -> None:
+    actions = torch.tensor([[[9.0], [12.0], [15.0], [18.0]]])
+    last_action = torch.tensor([[0.0]])
+
+    blended = blend_action_chunk(actions, last_action, blend_steps=3)
+
+    torch.testing.assert_close(blended, torch.tensor([[[3.0], [8.0], [15.0], [18.0]]]))
+
+
+def test_blend_action_chunk_can_be_disabled() -> None:
+    actions = torch.randn(1, 4, 2)
+
+    assert blend_action_chunk(actions, torch.zeros(1, 2), blend_steps=0) is actions
+    assert blend_action_chunk(actions, None, blend_steps=3) is actions
+
+
+def test_diffusion_config_rejects_invalid_blend_steps() -> None:
+    with pytest.raises(ValueError, match="action_chunk_blend_steps"):
+        DiffusionConfig(n_action_steps=8, action_chunk_blend_steps=9)
