@@ -44,6 +44,26 @@ from lerobot.policies.utils import (
 from lerobot.utils.constants import ACTION, OBS_ENV_STATE, OBS_IMAGES, OBS_STATE
 
 
+def blend_action_chunk(actions: Tensor, last_action: Tensor | None, blend_steps: int) -> Tensor:
+    """Blend the beginning of a new chunk with the last executed action."""
+    if last_action is None or blend_steps == 0:
+        return actions
+
+    blend_steps = min(blend_steps, actions.shape[1])
+    weights = torch.linspace(
+        1 / blend_steps,
+        1,
+        blend_steps,
+        device=actions.device,
+        dtype=actions.dtype,
+    ).view(1, blend_steps, 1)
+    blended_actions = actions.clone()
+    blended_actions[:, :blend_steps] = torch.lerp(
+        last_action.unsqueeze(1), actions[:, :blend_steps], weights
+    )
+    return blended_actions
+
